# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf

# Shell scripts must be LF (for NAS/Linux execution)
*.sh text eol=lf

# Windows scripts can be CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare files that will always have LF line endings
.devcontainer/post-create.sh text eol=lf
package/scripts/* text eol=lf
package/conf/* text eol=lf
